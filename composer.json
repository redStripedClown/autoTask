{
    "name": "auto-task/auto-task",
    "description": "Biblioteca de automação de tarefas com suporte a execução com e sem Composer",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "AutoTask\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AutoTask\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}